type BenchReport = record {
  rows : nat64;
  instructions : nat64;
  checksum : nat64;
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
};
type BenchReadProfileReport = record {
  rows : nat64;
  instructions : nat64;
  checksum : nat64;
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
  open_query : nat64;
  prepare : nat64;
  key_format : nat64;
  query_optional_string_text_total : nat64;
  reset_bind : nat64;
  step : nat64;
  column_read : nat64;
  report : nat64;
  x_read_calls : nat64;
  x_read_bytes : nat64;
  stable_data_read_calls : nat64;
  stable_data_read_bytes : nat64;
  page_table_root_hits : nat64;
  page_table_root_misses : nat64;
  page_table_segment_hits : nat64;
  page_table_segment_misses : nat64;
  superblock_loads : nat64;
};
type BenchGetManyProfileReport = record {
  rows : nat64;
  instructions : nat64;
  checksum : nat64;
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
  open_query : nat64;
  sql_build : nat64;
  key_build : nat64;
  prepare : nat64;
  bind : nat64;
  row_scan : nat64;
  report : nat64;
  x_read_calls : nat64;
  x_read_bytes : nat64;
  stable_data_read_calls : nat64;
  stable_data_read_bytes : nat64;
  page_table_root_hits : nat64;
  page_table_root_misses : nat64;
  page_table_segment_hits : nat64;
  page_table_segment_misses : nat64;
  superblock_loads : nat64;
};
type BenchWriteProfileReport = record {
  rows : nat64;
  instructions : nat64;
  checksum : nat64;
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
  open_update : nat64;
  prepare : nat64;
  key_value_format : nat64;
  execute_total : nat64;
  reset_bind : nat64;
  step : nat64;
  report : nat64;
  x_read_calls : nat64;
  x_read_bytes : nat64;
  x_write_calls : nat64;
  x_write_bytes : nat64;
  x_file_size_calls : nat64;
  x_lock_calls : nat64;
  x_unlock_calls : nat64;
  x_check_reserved_lock_calls : nat64;
  x_file_control_calls : nat64;
  x_device_characteristics_calls : nat64;
  stable_data_read_calls : nat64;
  stable_data_read_bytes : nat64;
  stable_data_write_calls : nat64;
  stable_data_write_bytes : nat64;
  stable_grow_calls : nat64;
  stable_grow_pages : nat64;
  page_table_root_hits : nat64;
  page_table_root_misses : nat64;
  page_table_segment_hits : nat64;
  page_table_segment_misses : nat64;
  superblock_loads : nat64;
  commit_load : nat64;
  commit_build_segments : nat64;
  commit_capacity : nat64;
  commit_page_write : nat64;
  commit_table_write : nat64;
  commit_superblock_store : nat64;
};
type BenchGrowthProfileReport = record {
  rows : nat64;
  writes : nat64;
  instructions : nat64;
  checksum : nat64;
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
  open_update : nat64;
  key_value_format : nat64;
  prepare : nat64;
  execute_total : nat64;
  changes : nat64;
  report : nat64;
  x_read_calls : nat64;
  x_read_bytes : nat64;
  x_write_calls : nat64;
  x_write_bytes : nat64;
  x_file_size_calls : nat64;
  x_lock_calls : nat64;
  x_unlock_calls : nat64;
  x_check_reserved_lock_calls : nat64;
  x_file_control_calls : nat64;
  x_device_characteristics_calls : nat64;
  stable_data_read_calls : nat64;
  stable_data_read_bytes : nat64;
  stable_data_write_calls : nat64;
  stable_data_write_bytes : nat64;
  stable_grow_calls : nat64;
  stable_grow_pages : nat64;
  page_table_root_hits : nat64;
  page_table_root_misses : nat64;
  page_table_segment_hits : nat64;
  page_table_segment_misses : nat64;
  superblock_loads : nat64;
  commit_load : nat64;
  commit_build_segments : nat64;
  commit_capacity : nat64;
  commit_page_write : nat64;
  commit_table_write : nat64;
  commit_superblock_store : nat64;
};
type DbStatsReport = record {
  db_size : nat64;
  stable_pages : nat64;
  stable_bytes : nat64;
  sqlite_page_size : nat64;
  sqlite_page_count : nat64;
  sqlite_freelist_count : nat64;
};

service : {
  bench_reset : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_insert_only : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_append_insert : (nat32, nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_update_only : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_read : (nat32) -> (variant { Ok : BenchReport; Err : text }) query;
  bench_read_public_helper : (nat32) -> (variant { Ok : BenchReport; Err : text }) query;
  bench_read_prepare_each : (nat32) -> (variant { Ok : BenchReport; Err : text }) query;
  bench_read_profile : (nat32) -> (variant { Ok : BenchReadProfileReport; Err : text }) query;
  bench_get_many_in : (nat32) -> (variant { Ok : BenchReport; Err : text }) query;
  bench_get_many_in_profile : (nat32) -> (variant { Ok : BenchGetManyProfileReport; Err : text }) query;
  bench_write : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_write_profile : (nat32) -> (variant { Ok : BenchWriteProfileReport; Err : text });
  bench_large_blob : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_many_rows : (nat32) -> (variant { Ok : BenchReport; Err : text }) query;
  bench_unbounded_order_by : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_join : (nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_growth : (nat32, nat32) -> (variant { Ok : BenchReport; Err : text });
  bench_growth_profile : (nat32, nat32) -> (variant { Ok : BenchGrowthProfileReport; Err : text });
  db_stats : () -> (variant { Ok : DbStatsReport; Err : text }) query;
}
